# MongoDB Connection String (Required)
# Get this from MongoDB Atlas: https://mongodb.com/cloud/atlas
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/qr_order_system

# Server Port (Default: 5000)
PORT=5000

# Frontend URL for CORS (Required for production)
# Set this to your Vercel deployment URL
FRONTEND_URL=https://your-app.vercel.app
